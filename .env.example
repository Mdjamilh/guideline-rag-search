# Optional. Leave empty to use the embedded PGlite database (with pgvector),
# which is migrated and filled from content/guidelines on first start.
# For Postgres (e.g. Neon with pgvector): set this, then run
#   npm run db:migrate && npm run ingest
DATABASE_URL=

# Optional. Ollama server for embeddings and answers (https://ollama.com).
# Without it the app runs in search-only mode with keyword retrieval.
#   ollama pull nomic-embed-text && ollama pull llama3.1
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional tuning.
VECTOR_MAX_DISTANCE=0.55
ASK_RATE_LIMIT=20
